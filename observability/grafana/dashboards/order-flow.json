{
  "uid": "order-observability",
  "title": "Order flow — metrics, logs & traces",
  "schemaVersion": 40,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {"list": [
    {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(demo_http_requests_total, service)", "includeAll": true, "allValue": ".+", "multi": true, "current": {"text": "All", "value": ["$__all"]}},
    {"name": "env", "label": "Environment", "type": "custom", "options": [{"text": "development", "value": "development", "selected": true}], "current": {"text": "development", "value": "development"}}
  ]},
  "annotations": {"list": [{"name": "Deploy / restart", "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "type": "dashboard", "enable": true, "iconColor": "#5794F2", "tags": ["deploy", "restart"]}]},
  "panels": [
    {"id": 1, "title": "Request rate", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "showPoints": "never"}}}, "targets": [{"expr": "sum by(service) (rate(demo_http_requests_total{service=~\"$service\"}[5m]))", "legendFormat": "{{service}}", "refId": "A"}]},
    {"id": 2, "title": "Error rate (%)", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]}}}, "targets": [{"expr": "sum by(service) (rate(demo_http_requests_total{service=~\"$service\",status=~\"4..|5..\"}[5m])) / clamp_min(sum by(service) (rate(demo_http_requests_total{service=~\"$service\"}[5m])), 1)", "legendFormat": "{{service}} all errors", "refId": "A"}]},
    {"id": 3, "title": "p95 latency", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 12}, "links": [{"title": "Open in Explore", "url": "/explore?left=\u0026orgId=1\u0026left=\u007b\u0022datasource\u0022:\u0022prometheus\u0022,\u0022queries\u0022:\u005b\u007b\u0022refId\u0022:\u0022A\u0022,\u0022expr\u0022:\u0022demo_http_request_duration_seconds_bucket\u0022\u007d\u005d,\u0022range\u0022:true\u007d"}]}}, "targets": [{"expr": "histogram_quantile(0.95, sum by(le,service) (rate(demo_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "{{service}}", "refId": "A", "exemplar": true}]},
    {"id": 4, "title": "Requests by status (rate)", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "bars", "fillOpacity": 85, "stacking": {"mode": "normal", "group": "A"}}}}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "sum"]}}, "targets": [{"expr": "sum by(service,status) (rate(demo_http_requests_total{service=~\"$service\"}[5m]))", "legendFormat": "{{service}} / {{status}}", "refId": "A"}]},
    {"id": 5, "title": "Service scrape health", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 16, "w": 12, "h": 7}, "fieldConfig": {"defaults": {"unit": "none", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}}, "options": {"textMode": "name", "colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"expr": "up", "legendFormat": "{{job}} / {{instance}}", "refId": "A"}]},
    {"id": 6, "title": "Gateway request rate", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 16, "w": 12, "h": 7}, "fieldConfig": {"defaults": {"unit": "reqps"}}, "targets": [{"expr": "sum by(service,route) (rate(kong_http_requests_total[5m]))", "legendFormat": "{{service}} / {{route}}", "refId": "A", "exemplar": true}]},
    {"id": 7, "title": "Correlated service logs — click TraceID", "type": "logs", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"x": 0, "y": 23, "w": 24, "h": 10}, "targets": [{"expr": "{service_name=~\"$service\"}", "refId": "A"}]},
    {"id": 8, "title": "Distributed traces", "type": "traces", "datasource": {"type": "tempo", "uid": "tempo"}, "gridPos": {"x": 0, "y": 33, "w": 24, "h": 9}, "targets": [{"queryType": "traceql", "query": "{ resource.service.name =~ \"$service\" }", "refId": "A"}]},
    {"id": 9, "title": "4xx rate", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 42, "w": 12, "h": 7}, "fieldConfig": {"defaults": {"unit": "reqps"}}, "targets": [{"expr": "sum by(service) (rate(demo_http_requests_total{service=~\"$service\",status=~\"4..\"}[5m]))", "legendFormat": "{{service}} 4xx", "refId": "A"}]},
    {"id": 10, "title": "5xx rate", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 42, "w": 12, "h": 7}, "fieldConfig": {"defaults": {"unit": "reqps"}}, "targets": [{"expr": "sum by(service) (rate(demo_http_requests_total{service=~\"$service\",status=~\"5..\"}[5m]))", "legendFormat": "{{service}} 5xx", "refId": "A"}]}
  ]
}
